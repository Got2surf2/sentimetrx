# Sentimetrx — environment variable template.
# Copy to `.env.local` (gitignored) and fill in real values. Placeholders below
# are NOT real credentials. Grouped by subsystem; only the "Core" block is
# required to boot the app — the rest gate optional features.

# ── Core: Supabase (required) ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only; bypasses RLS — never expose to the client
# SUPABASE_URL is read server-side by a few scripts; usually identical to NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=https://your-project.supabase.co

# ── AI providers ──────────────────────────────────────────────────────────────
# AI_PROVIDER selects the default backend: 'anthropic' (default) | 'openai' | 'azure'.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...                       # default provider; platform key all orgs piggyback on
OPENAI_API_KEY=sk-...                              # optional, only if AI_PROVIDER=openai
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com   # optional, AI_PROVIDER=azure
AZURE_OPENAI_API_KEY=your-azure-key
AZURE_OPENAI_API_VERSION=2024-02-15-preview
DEEPGRAM_API_KEY=your-deepgram-key                 # recordings ASR (transcription)

# ── Email / SMS ───────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...                              # campaign + transactional email
RESEND_WEBHOOK_SECRET=whsec_...                    # verifies Resend delivery webhooks
SENDGRID_API_KEY=SG....                            # optional alternate email provider
TWILIO_ACCOUNT_SID=AC...                           # optional SMS campaigns
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+15555550100

# ── Data sources ──────────────────────────────────────────────────────────────
DATAFORSEO_LOGIN=your-login                         # Google Reviews ingest
DATAFORSEO_PASSWORD=your-password
GOOGLE_PLACES_API_KEY=your-google-places-key
REGULATIONS_GOV_API_KEY=your-regulations-gov-key
# GOAA_API_KEY / MERIDIAN_TOKEN: optional overrides for the MCO demo integrations.
# Both fall back to the documented PUBLIC flymco.com bundle tokens in lib/ when unset.
GOAA_API_KEY=
MERIDIAN_TOKEN=

# ── Social (Meta / Instagram / Facebook) ──────────────────────────────────────
META_APP_ID=your-app-id
META_APP_SECRET=your-app-secret
META_REDIRECT_URI=https://your-domain.com/api/social/oauth/callback
META_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token

# ── Storage / backups (AWS S3) ────────────────────────────────────────────────
RECORDINGS_BUCKET=recordings                        # Supabase Storage bucket for recording media
BACKUP_S3_BUCKET=your-backup-bucket
BACKUP_S3_REGION=us-east-1
BACKUP_S3_KMS_KEY_ID=your-kms-key-id
BACKUP_AWS_ACCESS_KEY_ID=your-aws-access-key-id
BACKUP_AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# ── Recordings pipeline infra ─────────────────────────────────────────────────
FFMPEG_SANDBOX_SNAPSHOT_ID=                         # optional: Vercel Sandbox snapshot with ffmpeg pre-installed

# ── Secrets / signing ─────────────────────────────────────────────────────────
CRON_SECRET=generate-a-long-random-string           # Bearer token guarding /api/cron/*
OAUTH_STATE_SECRET=generate-a-long-random-string     # HMAC key for OAuth state params

# ── Observability (Sentry) ────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_AUTH_TOKEN=your-sentry-auth-token             # build-time: source map upload
SENTRY_ORG=your-org
SENTRY_PROJECT=your-project
SENTRY_ORG_SLUG=your-org
SENTRY_PROJECT_SLUG=your-project
SENTRY_ALERT_TO=alerts@example.com                   # cron alert recipient

# ── URLs ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PROBE_BASE_URL=http://localhost:3000                 # used by simulation/probe scripts
# NEXT_PUBLIC_BUILD_NUMBER / NEXT_PUBLIC_BUILD_DATE are derived at build time in next.config.js — do not set.

# ── Internal flags (leave unset in normal operation) ──────────────────────────
# NODE_ENV                       # set by the runtime
# DUAL_WRITE_PHASE3=             # PulseIQ phase-3 migration toggle
# READ_PHASE3=                   # PulseIQ phase-3 read toggle
# TOWNHALL_VIA_AGENT_HANDLER=    # route town-hall chat through the shared agent handler
# DRY_RUN=                       # scripts: simulate without writing
# PM1_OUT_DIR=                   # recordings PM-1 calibration harness output dir
# SKIP_SPEC_CHECK=1              # pre-commit: bypass spec-drift guard (justify in commit)
# SKIP_DEVLOG_CHECK=1            # pre-commit: bypass devlog guard (justify in commit)
