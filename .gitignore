node_modules/
.next/
.env
.env.local
.env.*.local
.DS_Store
*.tsbuildinfo
out/
.vercel
.env*.local

# Test artifacts
coverage/
playwright-report/
test-results/
.playwright/

# Supabase CLI link state — local-only, regenerated by `supabase link`
supabase/.temp/

# Private keys / certs — never commit. No such files in the repo today;
# the W19 governance audit flagged the gap, so ignore them up front.
*.pem
*.key
*.p12
*.pfx

# Local regression run output (full Sarina transcripts, etc.). Baselines are
# reproducible by re-running scripts/sarina-regression-run.ts — no need to
# track the JSON in git. The directory is kept locally so before/after diffs
# work across sessions; baseline counts are captured in the weekly devlog.
.regression-baselines/

# Stray incremental-build snapshots that `tsc` writes alongside `tsconfig.tsbuildinfo`
# when invoked with non-canonical config paths (e.g. `tsc -p tsconfig\ 5.json`).
# Covered by the `*.tsbuildinfo` glob on line 7, but listed here so the intent
# is explicit when grepping .gitignore for "tsbuildinfo".
*.tsbuildinfo

# RC keyword-mining intermediate (Path B) — regenerate via scripts/pilot-rc-keyword-mine.ts
data/keyword-candidates*.jsonl
