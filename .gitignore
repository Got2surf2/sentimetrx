node_modules/
.next/
.env
.env.local
.env.*.local
.DS_Store
*.tsbuildinfo
out/
.vercel
.env*.local

# Test artifacts
coverage/
playwright-report/
test-results/
.playwright/

# Supabase CLI link state — local-only, regenerated by `supabase link`
supabase/.temp/

# Private keys / certs — never commit. No such files in the repo today;
# the W19 governance audit flagged the gap, so ignore them up front.
*.pem
*.key
*.p12
*.pfx

# Local regression run output (full Sarina transcripts, etc.). Baselines are
# reproducible by re-running scripts/sarina-regression-run.ts — no need to
# track the JSON in git. The directory is kept locally so before/after diffs
# work across sessions; baseline counts are captured in the weekly devlog.
.regression-baselines/

# Stray incremental-build snapshots that `tsc` writes alongside `tsconfig.tsbuildinfo`
# when invoked with non-canonical config paths (e.g. `tsc -p tsconfig\ 5.json`).
# Covered by the `*.tsbuildinfo` glob on line 7, but listed here so the intent
# is explicit when grepping .gitignore for "tsbuildinfo".
*.tsbuildinfo

# RC keyword-mining intermediate (Path B) — regenerate via scripts/pilot-rc-keyword-mine.ts
data/keyword-candidates*.jsonl
data/chuys-candidates*.jsonl

# Personal, per-project Claude Code settings (never commit)
.claude/settings.local.json

# Active one-off scratch scripts (underscore convention) — deliberately
# untracked while in use; move to scripts/oneoff/ (committed) when shipped.
# The scripts/_verify_*.ts PulseIQ regression harness lives here on purpose
# (docs/CONVERGENCE.md § 4.2).
scripts/_*.ts
scripts/_*.mjs
scripts/_*.sql

# Promotion manifests (scripts/promote.ts) — reviewable JSON artifacts that
# can carry client config (prompts, discussion guides); never committed.
promotions/
scripts/_*.json

# Harness-local session lock — machine state, never commit (was committed by accident once)
.claude/scheduled_tasks.lock

# Vercel Workflow DevKit generated routes (regenerated by dev/build)
app/.well-known/workflow/
