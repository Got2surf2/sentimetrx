{
  "name": "sentimetrx",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "bash scripts/dev.sh test",
    "dev:prod": "bash scripts/dev.sh prod",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:rls": "RLS_TEST=1 vitest run rls-isolation",
    "test:egress": "EGRESS_TEST=1 vitest run cross-org-egress",
    "test:auth-flows": "AUTH_FLOWS_TEST=1 vitest run auth-flows",
    "test:campaign-egress": "CAMPAIGN_EGRESS_TEST=1 vitest run campaign-routes-egress",
    "test:dataset-egress": "DATASET_EGRESS_TEST=1 vitest run dataset-routes-egress",
    "loadtest:k6": "k6 run tests/loadtest/townhall.k6.js",
    "loadtest:browsers": "playwright test --config=tests/loadtest/playwright.config.ts",
    "spec-drift": "tsx scripts/spec-drift.ts",
    "check:sql-tx": "tsx scripts/check-sql-tx-wrap.ts",
    "check:no-legacy-rows": "tsx scripts/check-no-legacy-dataset-rows.ts",
    "migrate": "tsx scripts/apply-migration.ts",
    "migrate:status": "tsx scripts/migrations-status.ts",
    "promote": "tsx scripts/promote.ts",
    "schema:snapshot": "supabase db dump --linked --schema public -f docs/db/schema.sql",
    "check:spec-staged": "tsx scripts/check-spec-drift-staged.ts",
    "postinstall": "git config core.hooksPath .githooks 2>/dev/null || true",
    "lint:ci": "eslint . --max-warnings 195"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1024.0",
    "@aws-sdk/lib-storage": "^3.1079.0",
    "@aws-sdk/s3-request-presigner": "^3.1024.0",
    "@sentry/nextjs": "^10.51.0",
    "@sparticuz/chromium": "^149.0.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.44.4",
    "@vercel/functions": "^3.5.1",
    "@vercel/sandbox": "^2.0.2",
    "@workflow/next": "^4.0.6",
    "emoji-picker-element": "^1.29.1",
    "exceljs": "^4.4.0",
    "html-to-image": "^1.11.13",
    "isomorphic-dompurify": "^2.26.0",
    "lottie-web": "^5.13.0",
    "mammoth": "^1.12.0",
    "next": "^16.2.7",
    "plotly.js-dist-min": "^2.35.0",
    "pptxgenjs": "^4.0.1",
    "puppeteer-core": "^25.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sentiment": "^5.0.2",
    "server-only": "^0.0.1",
    "tus-js-client": "^4.3.1",
    "unpdf": "^1.6.2",
    "workflow": "^4.2.5",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@types/sentiment": "^5.0.4",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "autoprefixer": "^10.0.1",
    "docx": "^9.6.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.10",
    "jsdom": "^26.1.0",
    "msw": "^2.14.5",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "undici": "^7.29.0",
    "piscina": "5.2.0",
    "devalue": "5.8.1",
    "esbuild": "0.28.1",
    "vite": "8.0.16",
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "postcss": "$postcss",
    "fast-uri": "^3.1.5",
    "body-parser": "1.20.6",
    "nanoid": "^5.1.16",
    "brace-expansion@1": "^1.1.18"
  }
}
