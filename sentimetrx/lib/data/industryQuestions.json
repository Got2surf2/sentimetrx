{
  "description": "Structured multiple-choice industry questions for study context and screening",
  "industries": [
    {
      "industry": "healthcare",
      "questions": [
        { "key": "i_hc_type",      "prompt": "What type of healthcare visit was this?",                        "exportLabel": "Visit Type",           "type": "radio", "options": ["Routine check-up", "Follow-up appointment", "Urgent care", "Specialist consultation", "Procedure or treatment"] },
        { "key": "i_hc_insurance",  "prompt": "How do you typically pay for healthcare?",                       "exportLabel": "Payment Method",       "type": "radio", "options": ["Private insurance", "Medicare / Medicaid", "Self-pay", "Employer-provided insurance", "Prefer not to say"] },
        { "key": "i_hc_access",     "prompt": "How easy is it for you to access healthcare when you need it?",  "exportLabel": "Healthcare Access",    "type": "radio", "options": ["Very easy", "Fairly easy", "Neutral", "Somewhat difficult", "Very difficult"] },
        { "key": "i_hc_comms",      "prompt": "How well does our team keep you informed about your care?",      "exportLabel": "Care Communication",   "type": "radio", "options": ["Extremely well", "Very well", "Adequately", "Not well enough", "Poorly"] }
      ]
    },
    {
